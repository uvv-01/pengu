# Pengu Environment Variables
# Copy this to .env and fill in as needed.
# Most variables are OPTIONAL — Pengu works without any of them.

# Cost mode: FREE_ONLY (default) or FREE_PLUS_CLOUD
PENGU_COST_MODE=FREE_ONLY

# Debug mode
PENGU_DEBUG=false

# API server
PENGU_API__HOST=127.0.0.1
PENGU_API__PORT=8420

# Optional: Cloud API keys (only used when cost_mode=FREE_PLUS_CLOUD)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional: Model overrides (auto-detected from hardware if not set)
# PENGU_MODEL__LOCAL_LLM_MODEL=qwen2.5:7b
# PENGU_MODEL__LOCAL_CODING_MODEL=qwen2.5-coder:7b
# PENGU_MODEL__STT_MODEL=distil-small.en
# PENGU_MODEL__TTS_MODEL=kokoro
